{
  "name": "repair-system-mvp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n API,ADMIN -c cyan,magenta \"npm run dev:api\" \"npm run dev:admin\"",
    "dev:api": "node server/index.js",
    "dev:web": "npm run dev:admin",
    "dev:client": "vite --config vite.client.config.js",
    "dev:admin": "vite --config vite.admin.config.js",
    "db:init": "node database/init-mysql.mjs",
    "db:init:ps": "powershell -ExecutionPolicy Bypass -File database/init-mysql.ps1",
    "build": "npm run build:admin",
    "test": "node --test ./test/*.test.mjs",
    "build:all": "vite build",
    "build:client": "vite build --config vite.client.config.js",
    "build:admin": "vite build --config vite.admin.config.js",
    "preview:client": "vite preview --config vite.client.config.js --host 127.0.0.1",
    "preview:admin": "vite preview --config vite.admin.config.js --host 127.0.0.1"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@vitejs/plugin-vue": "^6.0.1",
    "@zxing/browser": "^0.2.1",
    "concurrently": "^9.2.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "element-plus": "^2.11.7",
    "express": "^5.1.0",
    "gsap": "^3.13.0",
    "mysql2": "^3.15.3",
    "vite": "^7.1.12",
    "vue": "^3.5.22",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "unplugin-vue-components": "^32.1.0"
  }
}

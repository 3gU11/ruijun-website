USE_MYSQL=true
NODE_ENV=development
AUTH_SECRET=replace-with-a-long-random-secret
COOKIE_SECURE=false
TRUST_PROXY=false
CORS_ORIGINS=http://127.0.0.1:2888,http://localhost:2888,http://127.0.0.1:1888,http://localhost:1888
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=repair_system
# V8 / finished-goods database; Repair reads the authoritative model dictionary from this table.
MODEL_DICTIONARY_SCHEMA=rjfinshed
MODEL_DICTIONARY_TABLE=model_dictionary
MACHINE_WARRANTY_MONTHS=12
PORT=3101
HOST=127.0.0.1
VITE_OFFICIAL_SITE_URL=http://127.0.0.1:4173/
# FAQ/Dify 阶段启用前保持为空；启用时两项必须同时配置。
FAQ_BFF_INTERNAL_URL=
FAQ_BFF_INTERNAL_KEY=
FAQ_BFF_TIMEOUT_MS=3500
VITE_FAQ_BFF_PUBLIC_URL=

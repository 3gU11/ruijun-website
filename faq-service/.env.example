FAQ_ENV=development
FAQ_HOST=127.0.0.1
FAQ_PORT=3201
FAQ_REDIS_URL=redis://127.0.0.1:6379/3
FAQ_DIFY_BASE_URL=https://your-dify.example.com/v1
FAQ_DIFY_API_KEY=
FAQ_INTERNAL_API_KEY=replace-with-a-long-random-service-key
FAQ_SIGNING_SECRET=replace-with-a-separate-long-random-secret
FAQ_ALLOWED_ORIGINS=http://127.0.0.1:4173,http://localhost:4173,http://127.0.0.1:2888,http://localhost:2888
FAQ_COOKIE_SECURE=false
FAQ_SESSION_TTL_SECONDS=86400
FAQ_HANDOFF_TTL_SECONDS=300
FAQ_IDEMPOTENCY_TTL_SECONDS=900
FAQ_DAILY_QUOTA=30
FAQ_CHANNEL_CONCURRENCY=100
FAQ_INPUT_MAX_LENGTH=2000
FAQ_DIFY_CONNECT_TIMEOUT_SECONDS=5
FAQ_DIFY_FIRST_BYTE_TIMEOUT_SECONDS=15
FAQ_DIFY_STREAM_TIMEOUT_SECONDS=60

